# --------------------------------------------------------------------------
# ApexPHP Environment Configuration
# --------------------------------------------------------------------------
#
# This file is a template for the environment variables.
# Copy this file to .env and fill in your specific settings.
# The .env file is ignored by git for security reasons.

# -- Application Settings --
APP_NAME="ApexPHP"
APP_ENV=local
APP_DEBUG=true

# -- Database Connection --
# This is the primary connection that the framework will use.
# Supported drivers: "sqlite", "mysql", "pgsql"
DB_CONNECTION=sqlite

# --- Connection Details ---
# For MySQL/PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=apex
DB_USERNAME=root
DB_PASSWORD=

# For SQLite, you can specify an absolute path for DB_DATABASE.
# If left empty, the framework will default to the path defined
# in config/database.php (typically BASE_PATH/database/main.db).
# DB_DATABASE=
